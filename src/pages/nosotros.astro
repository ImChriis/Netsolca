---
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Process from '../components/Process.astro';
import Clients from '../components/Clients.astro';
import CtaBand from '../components/CtaBand.astro';
import { team } from '../data/team';
import { mission, vision, values } from '../data/about';

const site = Astro.site ?? new URL('https://www.netsolca.com');
const url = new URL('/nosotros', site).href;

// Datos estructurados: página "Acerca de" + migas de pan
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'Nosotros | NETSOLCA',
    url,
    inLanguage: 'es-VE',
    about: { '@id': new URL('/#organizacion', site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Nosotros', item: url },
    ],
  },
];
---
<BaseLayout
  title="Nosotros: más de 20 años desarrollando software | NETSOLCA"
  description="NETSOLCA: más de 20 años desarrollando sistemas ERP, MRP y CRM, páginas web y tiendas en línea en Maracaibo. Conoce a nuestro equipo y sus valores."
  current="nosotros"
  subpage
  schema={schema}
>
  <PageHero
    crumb="Nosotros"
    title="Nosotros"
    lead="Somos una empresa de Maracaibo dedicada al desarrollo de software para empresas, con más de 20 años de trayectoria."
  />

  <!-- Historia + valores -->
  <section class="section about" aria-labelledby="historia-title">
    <div class="container">
      <div class="about__grid">
        <div class="about__media" data-reveal>
          <figure class="about__photo about__photo--tall">
            <Picture
              src="/assets/img/fotos/equipo-oficina"
              widths={[450, 700]}
              sizes="(min-width: 960px) 26vw, 55vw"
              alt="Equipo de desarrollo trabajando frente a varios monitores con código"
              width="700" height="900" decoding="async" />
          </figure>
          <figure class="about__photo about__photo--short">
            <Picture
              src="/assets/img/fotos/equipo-reunion"
              widths={[400, 600]}
              sizes="(min-width: 960px) 20vw, 42vw"
              alt="Personas reunidas alrededor de una mesa con portátiles planificando un proyecto"
              width="600" height="600" decoding="async" />
          </figure>
          <div class="about__mission on-dark">
            <p class="about__mission-number">+20</p>
            <p>años de trayectoria en desarrollo de software empresarial.</p>
          </div>
        </div>

        <div class="about__content">
          <header class="section-head" data-reveal>
            <h2 class="section-title" id="historia-title">Software hecho en Maracaibo para empresas de toda Venezuela</h2>
          </header>
          <div class="about__copy" data-reveal>
            <p>NETSOLCA desarrolla sistemas ERP, MRP y CRM, páginas web y tiendas en línea para empresas de comercio, servicios, salud e industria.</p>
            <p>En más de 20 años hemos acompañado a empresas que pasaron de hojas de cálculo y procesos en papel a sistemas que integran ventas, inventario, producción y administración.</p>
            <p>Cada proyecto parte de un diagnóstico de tus procesos, se entrega con capacitación para tu equipo y queda respaldado por soporte técnico permanente.</p>
          </div>
          <ul class="about__values" role="list" data-reveal>
            {values.map((value) => (
              <li>
                <h3>{value.title}</h3>
                <p>{value.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Misión y visión -->
  <section class="section section--mist purpose" aria-label="Misión y visión">
    <div class="container purpose__grid">
      <article class="purpose__card" data-reveal>
        <span class="purpose__icon" aria-hidden="true"><svg><use href="#i-route" /></svg></span>
        <h2 class="purpose__title">Misión</h2>
        <p>{mission}</p>
      </article>
      <article class="purpose__card purpose__card--dark on-dark" data-reveal>
        <span class="purpose__icon" aria-hidden="true"><svg><use href="#i-globe" /></svg></span>
        <h2 class="purpose__title">Visión</h2>
        <p>{vision}</p>
      </article>
    </div>
  </section>

  <!-- Equipo -->
  <section class="section team" aria-labelledby="equipo-title">
    <div class="container">
      <header class="section-head section-head--center" data-reveal>
        <h2 class="section-title" id="equipo-title">El equipo</h2>
        <p class="section-lead">Las personas que desarrollan, instalan y dan soporte a tus sistemas.</p>
      </header>
      <ul class="team__grid" role="list" data-reveal>
        {team.map((member) => (
          <li class="member">
            <figure class="member__photo">
              {member.photo
                ? <Picture src={member.photo} widths={[600, 900]} sizes="(min-width: 1100px) 300px, (min-width: 480px) 50vw, 140px" alt={`${member.name}, ${member.role}`} width="600" height="800" loading="lazy" decoding="async" />
                : <img class="member__mark" src="/assets/img/logo-n-blanco.png" alt="" width="700" height="440" loading="lazy" decoding="async" />}
            </figure>
            <div class="member__body">
              <h3 class="member__name">
                {member.link ? <a href={member.link} target="_blank" rel="noopener">{member.name}</a> : member.name}
              </h3>
              <p class="member__role">{member.role}</p>
              <p class="member__bio">{member.bio}</p>
              {(member.github || member.linkedin) && (
                <div class="member__links">
                  {member.github && (
                    <a class="member__profile" href={member.github} target="_blank" rel="noopener">
                      <svg aria-hidden="true"><use href="#i-github" /></svg>
                      <span>GitHub</span>
                      <span class="sr-only"> de {member.name}</span>
                    </a>
                  )}
                  {member.linkedin && (
                    <a class="member__profile" href={member.linkedin} target="_blank" rel="noopener">
                      <svg aria-hidden="true"><use href="#i-linkedin" /></svg>
                      <span>LinkedIn</span>
                      <span class="sr-only"> de {member.name}</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Proceso de trabajo (traza animada) -->
  <section class="section section--mist" aria-label="Cómo trabajamos">
    <div class="container">
      <Process headingLevel="h2" />
    </div>
  </section>

  <!-- Clientes -->
  <section class="section section--navy why on-dark team-clients" aria-label="Empresas que confían en nosotros">
    <div class="container">
      <Clients />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
