---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Services from '../components/home/Services.astro';
import Offer from '../components/home/Offer.astro';
import Projects from '../components/home/Projects.astro';
import Quote from '../components/home/Quote.astro';
import About from '../components/home/About.astro';
import Why from '../components/home/Why.astro';
import Faq from '../components/home/Faq.astro';
import Contact from '../components/home/Contact.astro';
import { faq } from '../data/faq';
import { SITE } from '../data/site';

// Datos estructurados: preguntas frecuentes (pueden mostrarse en Google)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
const heroPhoto = '/assets/img/fotos/hero-principal';
---
<BaseLayout title={SITE.title} description={SITE.description} current="inicio" schema={[faqSchema]}>
  <!-- La foto principal del hero se pide de inmediato (mejora el LCP) -->
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    fetchpriority="high"
    href={`${heroPhoto}-900.webp`}
    imagesrcset={`${heroPhoto}-600.webp 600w, ${heroPhoto}-900.webp 900w, ${heroPhoto}-1400.webp 1400w`}
    imagesizes="(min-width: 1080px) 36vw, 90vw"
  />

  <Hero />
  <Services />
  <Offer />
  <Projects />
  <Quote />
  <About />
  <Why />
  <Faq />
  <Contact />
</BaseLayout>
