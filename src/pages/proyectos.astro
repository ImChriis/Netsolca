---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import CtaBand from '../components/CtaBand.astro';
import { projects } from '../data/projects';

const site = Astro.site ?? new URL('https://www.netsolca.com');
const url = new URL('/proyectos', site).href;

// Datos estructurados: portafolio + migas de pan
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Proyectos de NETSOLCA',
    url,
    inLanguage: 'es-VE',
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: projects.map((p, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'CreativeWork',
          '@id': `${url}#${p.id}`,
          name: p.title,
          about: p.sector,
          description: p.problem,
          url: `${url}#${p.id}`,
          creator: { '@id': new URL('/#organizacion', site).href },
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Proyectos', item: url },
    ],
  },
];
---
<BaseLayout
  title="Proyectos: sistemas, páginas y tiendas en línea | NETSOLCA"
  description="Sistemas de inventario, tiendas en línea, agendas de citas, paneles de reportes y páginas web desarrollados por NETSOLCA para empresas en Venezuela."
  current="proyectos"
  subpage
  schema={schema}
>
  <PageHero
    crumb="Proyectos"
    title="Proyectos"
    lead="Sistemas, páginas y tiendas en línea que hemos desarrollado para empresas de distintos sectores."
  />

  <section class="section projects projects--all" aria-label="Todos los proyectos">
    <div class="container">
      <ul class="projects__grid" role="list">
        {projects.map((project) => <ProjectCard project={project} href={`#${project.id}`} />)}
      </ul>
    </div>
  </section>

  <section class="section section--mist details" aria-label="Detalle de cada proyecto">
    <div class="container">
      <div class="details__list">
        {projects.map((project) => <ProjectDetail project={project} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
