---
/** Tarjeta de proyecto: foto, sector, título y "Ver más". */
import type { Project } from '../data/projects';
import { photoUrl } from '../data/site';

interface Props {
  project: Project;
  href: string;
}
const { project, href } = Astro.props;
---
<li class="project">
  <a class="project__media" href={href} tabindex="-1" aria-hidden="true">
    <img src={photoUrl(project.photo, 720, 480, 70)} alt={project.alt} width="720" height="480" loading="lazy" decoding="async" />
  </a>
  <p class="project__sector">{project.sector}</p>
  <h3 class="project__title">{project.title}</h3>
  <a class="link-trace" href={href}>
    Ver más <span class="sr-only">sobre {project.title.toLowerCase()}</span>
    <svg class="link-trace__icon" aria-hidden="true"><use href="#i-trace" /></svg>
  </a>
</li>
