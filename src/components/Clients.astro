---
/** Logos de clientes en movimiento (va sobre fondo azul profundo). */
---
<!-- Empresas que confían en NETSOLCA (logos blancos sobre negro: se funden con el azul) -->
<div class="clients" data-reveal>
  <p class="clients__title">Empresas que confían en nosotros</p>
  <div class="clients__marquee">
    <div class="marquee" data-marquee style="--marquee-speed: 30">
      <ul class="marquee__group clients__list" role="list">
        <li class="client"><img class="client__logo" src="/assets/img/clientes/mi-ternerita-house.png" alt="Mi Ternerita House" width="104" height="104" loading="lazy" decoding="async"></li>
        <li class="client"><img class="client__logo" src="/assets/img/clientes/evential.png" alt="Evential" width="104" height="104" loading="lazy" decoding="async"></li>
        <li class="client"><img class="client__logo" src="/assets/img/clientes/the-calenton.png" alt="The Calenton" width="104" height="104" loading="lazy" decoding="async"></li>
        <li class="client"><img class="client__logo" src="/assets/img/clientes/catedra-gaitera.png" alt="Cátedra Gaitera" width="104" height="104" loading="lazy" decoding="async"></li>
      </ul>
    </div>
  </div>
</div>
