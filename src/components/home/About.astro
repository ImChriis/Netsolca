---
import Process from '../Process.astro';
---
<!-- ============ NOSOTROS ============ -->
<section class="section about" id="nosotros" aria-labelledby="nosotros-title" data-section="nosotros">
  <div class="container">
    <div class="about__grid">
      <div class="about__media" data-reveal>
        <figure class="about__photo about__photo--tall">
          <img
            src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=700&q=70"
            srcset="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=450&q=70 450w,
                    https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=700&q=70 700w"
            sizes="(min-width: 960px) 26vw, 55vw"
            alt="Equipo de desarrollo trabajando frente a varios monitores con código"
            width="700" height="900" loading="lazy" decoding="async">
        </figure>
        <figure class="about__photo about__photo--short">
          <img
            src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=70"
            srcset="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=400&q=70 400w,
                    https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=600&q=70 600w"
            sizes="(min-width: 960px) 20vw, 42vw"
            alt="Personas reunidas alrededor de una mesa con portátiles planificando un proyecto"
            width="600" height="600" loading="lazy" decoding="async">
        </figure>
        <div class="about__mission on-dark">
          <p class="about__mission-number">+20</p>
          <p>años de trayectoria en desarrollo de software empresarial.</p>
        </div>
      </div>

      <div class="about__content">
        <header class="section-head" data-reveal>
          <h2 class="section-title" id="nosotros-title">Más de 20 años desarrollando software para empresas</h2>
        </header>
        <div class="about__copy" data-reveal>
          <p>Desde Maracaibo, NETSOLCA desarrolla sistemas ERP, MRP y CRM, páginas web y tiendas en línea para empresas de comercio, servicios, salud e industria.</p>
          <p>Cada proyecto parte de un diagnóstico de tus procesos, se entrega con capacitación para tu equipo y queda respaldado por soporte técnico permanente.</p>
        </div>
      </div>
    </div>

    <Process />
  </div>
</section>
