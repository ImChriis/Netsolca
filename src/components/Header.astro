---
/**
 * Header fijo. Las secciones con página propia (servicios, proyectos, nosotros,
 * contacto) siempre llevan a esa página; las demás usan anclas del inicio
 * (#cotizar en el inicio, /#cotizar desde las páginas internas).
 */
import { NAV, WHATSAPP_URL } from '../data/site';

interface Props {
  /** Id del enlace activo en páginas internas */
  current?: string;
}
const { current } = Astro.props;
const isHome = ['/', '', '/index', '/index.html'].includes(Astro.url.pathname);
const hrefFor = (item: (typeof NAV)[number]) => {
  if (item.page) return item.page;
  if (isHome) return item.anchor;
  return item.id === 'inicio' ? '/' : `/${item.anchor}`;
};
---
<header class="site-header" data-header   transition:persist="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={isHome ? '#inicio' : '/'} data-nav-brand>
      <img src="/assets/img/logo-netsolca.png" alt="NETSOLCA, ir al inicio" width="659" height="152" />
    </a>

    <nav
      class="site-nav"
      id="site-nav"
      aria-label="Principal"
      data-nav
      data-nav-config={JSON.stringify(NAV.map(({ id, anchor, page }) => ({ id, anchor, page: page ?? null })))}
    >
      <ul class="site-nav__list" role="list">
        {NAV.map((item) => (
          <li>
            <a
              class="site-nav__link"
              href={hrefFor(item)}
              data-nav-link={item.id}
              aria-current={current === item.id ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
      <span class="site-nav__indicator" aria-hidden="true"></span>
    </nav>

    <!-- WhatsApp visible desde la primera pantalla (en móvil queda solo el icono) -->
    <a class="btn btn--whatsapp btn--sm site-header__cta" href={WHATSAPP_URL} data-whatsapp>
      <svg class="btn__wa" aria-hidden="true"><use href="#i-whatsapp" /></svg>
      <span class="site-header__cta-text">WhatsApp</span>
      <span class="sr-only"> de NETSOLCA</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="sr-only" data-menu-label>Abrir menú</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</header>
