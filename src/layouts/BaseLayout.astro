---
/**
 * Layout principal: SEO, loader, header, footer, botón de WhatsApp y scripts.
 * El orden de los estilos importa: tokens → base → componentes → secciones.
 */
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Loader from '../components/Loader.astro';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { ClientRouter, fade } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Enlace activo del menú en páginas internas */
  current?: string;
  /** Páginas internas: header siempre con fondo */
  subpage?: boolean;
}
const { current, subpage = false, ...seo } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <SEO {...seo} />

    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Saira:wdth,wght@100..110,600..800&display=swap" />
    <slot name="head" />

    <!-- Loader: solo en la primera visita de la sesión y sin "reducir movimiento" (respaldo de 7 s) -->
    <script is:inline>
      (() => {
        try {
          const html = document.documentElement;
          if (sessionStorage.getItem('netsolca-loader') || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          html.classList.add('is-loading');
          setTimeout(() => html.classList.remove('is-loading'), 7000);
        } catch { /* sin sessionStorage: se omite el loader */ }
      })();
    </script>
    <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
  
    <ClientRouter/>
  
  </head>
  <body class={subpage ? 'subpage' : undefined}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Loader />
    <IconSprite />
    <Header current={current} />

    <main id="contenido">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat />

    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
